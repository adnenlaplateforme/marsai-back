# SERVER
IP=http://localhost
PORT=5000

# DATABASE
MYSQL_ROOT_PASSWORD=MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=MYSQL_DATABASE
MYSQL_USER=MYSQL_USER
MYSQL_PASSWORD=MYSQL_PASSWORD
MYSQL_PORT=3308
# Laisser vide hors conteneur (l'app joint MySQL sur localhost:MYSQL_PORT).
# En déploiement, docker-compose.prod.yml surcharge avec MYSQL_HOST=marsai-db
# et MYSQL_PORT=3306.
MYSQL_HOST=

# SITE ADMIN
ADMIN_EMAIL=
ADMIN_PASSWORD=

# JWT
JWT_SECRET=your_secret

# development || production
NODE_ENV=development

# MAIL CONFIG
# En développement, l'API tourne sur l'hôte et joint Mailpit par le port publié
# en loopback : aucun mail ne part vers une vraie adresse. En déploiement,
# docker-compose.prod.yml surcharge ces valeurs par mailpit:1025, à travers le
# réseau compose.
# 127.0.0.1 et non « localhost » : celui-ci résout d'abord en ::1, où Mailpit
# n'écoute pas, et chaque envoi paierait une tentative IPv6 ratée.
MAILER_HOST=127.0.0.1
MAILER_PORT=1025
# Sert d'en-tête From. Vide, il donnerait « MarsAi <> », que le SMTP refuse.
MAILER_EMAIL=noreply@marsai.local
# Mailpit n'annonce pas AUTH : nodemailer n'authentifie pas.
MAILER_PASS=""

# Port de l'interface web Mailpit, liée à 127.0.0.1.
# En local : http://127.0.0.1:8025
# Sur le VPS, par un tunnel : ssh -L 8025:127.0.0.1:8025 user@vps
MAILPIT_UI_PORT=8025

#FRONT
FRONT_IP=http://localhost:5173

SCALEWAY_ACCESS_KEY=""
SCALEWAY_SECRET_KEY=""
SCALEWAY_ENDPOINT=""
SCALEWAY_BUCKET_NAME=""
SCALEWAY_REGION=""
SCALEWAY_FOLDER=""
SCALEWAY_VIRTUAL_ENDPOINT=""
