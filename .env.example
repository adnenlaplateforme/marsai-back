# SERVER
IP=http://localhost
PORT=5000

# DATABASE
MYSQL_ROOT_PASSWORD=MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=MYSQL_DATABASE
MYSQL_USER=MYSQL_USER
MYSQL_PASSWORD=MYSQL_PASSWORD
MYSQL_PORT=3308
# Laisser vide hors conteneur (l'app joint MySQL sur localhost:MYSQL_PORT).
# Dans docker compose, l'app surcharge avec MYSQL_HOST=marsai-db et MYSQL_PORT=3306.
MYSQL_HOST=

# SITE ADMIN
ADMIN_EMAIL=
ADMIN_PASSWORD=

# JWT
JWT_SECRET=your_secret

# development || production
NODE_ENV=development

# MAIL CONFIG
# Ces quatre valeurs ne servent qu'en dehors de docker-compose.prod.yml, qui
# impose mailpit:1025 et n'envoie donc rien vers l'extérieur. MAILER_EMAIL y
# reste utilisé comme expéditeur affiché.
MAILER_HOST="smtp.maileroo.com"
MAILER_PORT=587
MAILER_EMAIL=""
MAILER_PASS=""

# Port de l'interface web Mailpit en déploiement, liée à 127.0.0.1 seulement.
# S'y connecter par un tunnel : ssh -L 8025:127.0.0.1:8025 user@vps
MAILPIT_UI_PORT=8025

#FRONT
FRONT_IP=http://localhost:5173

SCALEWAY_ACCESS_KEY=""
SCALEWAY_SECRET_KEY=""
SCALEWAY_ENDPOINT=""
SCALEWAY_BUCKET_NAME=""
SCALEWAY_REGION=""
SCALEWAY_FOLDER=""
SCALEWAY_VIRTUAL_ENDPOINT=""
