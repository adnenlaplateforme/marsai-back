# ==========================================================
# Environnement de TEST — chargé par vitest.setup.ts
# Copier ce fichier en `.env.test` et renseigner les valeurs.
# ==========================================================

# SERVER
IP=http://localhost
PORT=5000

# DATABASE — base de test DÉDIÉE dans le conteneur Docker `marsai-db`
# Même port que la dev (conteneur partagé), mais base séparée `marsai_test`.
# À créer une fois (voir README / commandes docker exec).
MYSQL_PORT=3308
MYSQL_DATABASE=marsai_test
# Utiliser root pour simplifier l'accès à la base de test locale
# (l'utilisateur applicatif n'a de droits que sur la base de dev par défaut).
MYSQL_USER=root
MYSQL_PASSWORD=your_root_password

# JWT
JWT_SECRET=test-secret

# Environnement (active la base de test + la garde de resetDatabase)
NODE_ENV=test

# FRONT (référencé par certains services)
FRONT_IP=http://localhost:5173

# S3 / SCALEWAY — valeurs factices.
# `src/middlewares/upload.ts` construit le storage multer-s3 au moment de
# l'import (multer-s3 jette « bucket is required » si la variable est vide),
# et ce middleware est atteint dès qu'un test importe `app`. Aucun appel réseau
# n'est fait tant qu'un test n'uploade pas réellement de fichier.
SCALEWAY_ENDPOINT=http://localhost:9000
SCALEWAY_ACCESS_KEY=test-access-key
SCALEWAY_SECRET_KEY=test-secret-key
SCALEWAY_BUCKET_NAME=test-bucket
SCALEWAY_REGION=fr-par
SCALEWAY_FOLDER=test
SCALEWAY_VIRTUAL_ENDPOINT=http://localhost:9000

# MAILER — valeurs factices, aucune connexion SMTP n'est ouverte en test
# (voir la garde NODE_ENV === 'test' dans src/services/email.service.ts).
MAILER_HOST=localhost
MAILER_PORT=587
MAILER_EMAIL=test@test.com
MAILER_PASS=test-password
