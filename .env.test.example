# ==========================================================
# Environnement de TEST — chargé par vitest.setup.ts
# Copier ce fichier en `.env.test` et renseigner les valeurs.
# ==========================================================

# SERVER
IP=http://localhost
PORT=5000

# DATABASE — base de test DÉDIÉE dans le conteneur Docker `marsai-db`
# Même port que la dev (conteneur partagé), mais base séparée `marsai_test`.
# À créer une fois (voir README / commandes docker exec).
MYSQL_PORT=3308
MYSQL_DATABASE=marsai_test
# Utiliser root pour simplifier l'accès à la base de test locale
# (l'utilisateur applicatif n'a de droits que sur la base de dev par défaut).
MYSQL_USER=root
MYSQL_PASSWORD=your_root_password

# JWT
JWT_SECRET=test-secret

# Environnement (active la base de test + la garde de resetDatabase)
NODE_ENV=test

# FRONT (référencé par certains services)
FRONT_IP=http://localhost:5173
